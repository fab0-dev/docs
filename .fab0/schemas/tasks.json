{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The docs factory's task list: one page or section per task",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "repo", "files", "acceptance"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
      "title": {"type": "string", "minLength": 1},
      "repo": {"const": "home"},
      "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "depends_on": {"type": "array", "items": {"type": "string"}},
      "acceptance": {
        "description": "The brief's acceptance checks this task meets.",
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^A[1-9][0-9]*$"}
      }
    }
  }
}
